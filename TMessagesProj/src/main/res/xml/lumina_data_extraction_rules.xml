<?xml version="1.0" encoding="utf-8"?>
<!--
    LuminaGram: backup and device-transfer rules (Android 12 and higher). 隱藏重複廣告 (AdShield) data stays
    on this device: both file roots and its prefs file are excluded from cloud backup and from
    device-to-device transfer. Everything else keeps the platform default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="luminagram_adshield" />
        <exclude domain="file" path="luminagram_adshield_img" />
        <exclude domain="sharedpref" path="luminagram_adshield.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="luminagram_adshield" />
        <exclude domain="file" path="luminagram_adshield_img" />
        <exclude domain="sharedpref" path="luminagram_adshield.xml" />
    </device-transfer>
</data-extraction-rules>
