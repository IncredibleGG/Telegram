<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode variant of the disguise launch theme (see values/lumina_disguise_styles.xml):
         same contract - no splash icon of our own, plain neutral background. -->
    <style name="Theme.Lumina.DisguiseLaunch" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
